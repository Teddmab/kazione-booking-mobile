# Copy to `.env` (never commit real secrets).
#
# Staff auth aligns with web prod by default — same cloud project as EAS / kazione.app:
#   EXPO_PUBLIC_SUPABASE_URL=https://hwvqbsqlvwvedyhfuiwt.supabase.co
#   EXPO_PUBLIC_API_BASE_URL=https://hwvqbsqlvwvedyhfuiwt.supabase.co/functions/v1
# Anon key: same as web VITE_SUPABASE_ANON_KEY / eas.json preview|production.
#
# Local Supabase (optional):
#   EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321  (simulator)
#   Physical device: use your PC LAN IP, not 127.0.0.1
#   Android emulator: http://10.0.2.2:54321
#
# Restart Expo after any change: npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://hwvqbsqlvwvedyhfuiwt.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-cloud-anon-key
EXPO_PUBLIC_API_BASE_URL=https://hwvqbsqlvwvedyhfuiwt.supabase.co/functions/v1
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=
EXPO_PUBLIC_WEB_APP_URL=https://kazione.app
EXPO_PUBLIC_SENTRY_DSN=
# AI goes through Edge Functions — do not put ANTHROPIC_API_KEY here
